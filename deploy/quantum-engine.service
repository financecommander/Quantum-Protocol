[Unit]
Description=Quantum Protocol HFT Engine
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=quantum
Group=quantum
WorkingDirectory=/opt/quantum-protocol
ExecStart=/usr/local/bin/quantum-engine
Restart=on-failure
RestartSec=5

# Environment
Environment=RUST_LOG=info
Environment=QP_UDP_ADDR=0.0.0.0:9999
EnvironmentFile=-/etc/quantum-protocol/env

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity
MemoryMax=4G
CPUQuota=200%

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/log/quantum
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
