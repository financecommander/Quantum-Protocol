[Unit]
Description=Quantum Protocol Python Engine
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=quantum
Group=quantum
WorkingDirectory=/opt/quantum-protocol
ExecStart=/usr/bin/python3 -m brain.engine
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONPATH=/opt/quantum-protocol
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/quantum-protocol/env

# Resource limits
LimitNOFILE=65536
MemoryMax=4G
CPUQuota=200%

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/log/quantum
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
