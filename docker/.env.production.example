# Quantum Protocol — Docker Production Environment Variables
# ============================================================
# Copy this file to docker/.env.production and fill in the values.
# Used by docker-compose.yml when running the full production stack.

# ---------------------------------------------------------------------------
# Quantum Engine
# ---------------------------------------------------------------------------

# UDP listen address inside the container
QP_UDP_ADDR=0.0.0.0:9999

# Rust log level (trace, debug, info, warn, error)
RUST_LOG=info

# Primary market-data feed API key
QP_API_KEY=your_market_data_api_key_here

# Alpaca broker API key (paper or live)
ALPACA_API_KEY=your_alpaca_api_key_here

# Alpaca broker secret key
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Interactive Brokers master account ID
IBKR_MASTER_ACCOUNT=your_ibkr_master_account_id_here

# Slack incoming-webhook URL for alerts
QP_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email address for Critical / Emergency alerts
QP_ALERT_EMAIL=alerts@your-domain.com

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------

# Scrape interval for the engine metrics endpoint
PROMETHEUS_SCRAPE_INTERVAL=5s

# Evaluation interval for recording/alerting rules
PROMETHEUS_EVAL_INTERVAL=15s

# Retention period for stored metrics
PROMETHEUS_RETENTION=15d

# Host port mapped to Prometheus UI (container always listens on 9090)
PROMETHEUS_PORT=9091

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------

# Admin password — CHANGE before deploying to production
GRAFANA_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Admin username (default: admin)
GRAFANA_ADMIN_USER=admin

# Host port mapped to Grafana UI (container listens on 3000)
GRAFANA_PORT=3000

# Allow anonymous access (true/false) — disable in production
GF_AUTH_ANONYMOUS_ENABLED=false

# Install plugins on first start (comma-separated)
GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-piechart-panel

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Engine metrics port (Prometheus scrape target inside the container)
ENGINE_METRICS_PORT=9090

# Engine UDP port exposed to the host
ENGINE_UDP_PORT=9999

# Docker network subnet (if using a custom bridge network)
DOCKER_NETWORK_SUBNET=172.28.0.0/16
