# Quantum Protocol — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# These variables are substituted into config/quantum_protocol.toml at load
# time via the ${ENV_VAR} syntax and referenced in docker-compose.yml.

# ---------------------------------------------------------------------------
# Data Feed Credentials
# ---------------------------------------------------------------------------

# Primary market-data feed API key
QP_API_KEY=your_market_data_api_key_here

# Alpaca broker API key (paper or live)
ALPACA_API_KEY=your_alpaca_api_key_here

# Alpaca broker secret key
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ---------------------------------------------------------------------------
# Broker / Account IDs
# ---------------------------------------------------------------------------

# Interactive Brokers master account ID for prop-scaling sleeve
IBKR_MASTER_ACCOUNT=your_ibkr_master_account_id_here

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------

# Slack incoming-webhook URL (all alert severities)
QP_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email address for Critical / Emergency alerts
QP_ALERT_EMAIL=alerts@your-domain.com

# ---------------------------------------------------------------------------
# Engine Runtime
# ---------------------------------------------------------------------------

# UDP listen address for the engine (host:port)
QP_UDP_ADDR=0.0.0.0:9999

# Rust log level (trace, debug, info, warn, error)
RUST_LOG=info

# ---------------------------------------------------------------------------
# Grafana (used by docker-compose.yml)
# ---------------------------------------------------------------------------

# Grafana admin password — change from the default before deploying
GRAFANA_PASSWORD=YOUR_SECURE_PASSWORD_HERE
