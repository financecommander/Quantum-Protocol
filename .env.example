# Quantum Protocol Environment Variables
# Copy this file to .env and fill in your actual values

# Engine Configuration
QP_CONFIG=config/quantum_protocol.toml
QP_UDP_ADDR=0.0.0.0:9999
QP_METRICS_PORT=9090

# Market Data Feed (Alpaca)
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# Alerting - Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alerting - Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password
ALERT_EMAIL_TO=team@example.com

# Grafana (for docker-compose)
GRAFANA_ADMIN_PASSWORD=admin

# Logging
RUST_LOG=info

# Optional: Additional broker API keys
BROKER_API_KEY=your_broker_api_key
BROKER_API_SECRET=your_broker_api_secret
